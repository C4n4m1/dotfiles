# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.

adjust-cursor-thickness = 1
# alpha-blending = linear
font-family = IoskeleyMono NerdFont
font-style = Medium
font-size = 11.8
# Map bold styles to regular/italic counterparts
window-decoration = false
font-style-bold = false
font-style-bold-italic = false
adjust-cell-height = 13%
theme = Oldworld
background = #131314
# background = #070708
foreground = #c9c7cd
# cursor-color =  #c9c7cd
cursor-opacity = 1
mouse-hide-while-typing
mouse-scroll-multiplier = 1
background-opacity = 0.92
# background-opacity-cells = true
unfocused-split-opacity = 0.8
window-padding-x = 10
window-padding-y = 10,10
window-padding-balance = true
window-theme = ghostty
clipboard-paste-protection = true
shell-integration = detect
shell-integration-features = sudo
bell-features = system,attention
quit-after-last-window-closed = false
confirm-close-surface = false
resize-overlay  = never
palette-generate = true
window-inherit-working-directory = false

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

gtk-tabs-location = hidden
# bottom or hidden

# KEYBINDS

# keybind =
# keybind=clear use = unbind instead to remove a default keybind
keybind = ctrl+shift+f=unbind
keybind = ctrl+shift+p=unbind
keybind = ctrl+g>p=toggle_command_palette
keybind = ctrl+g>f=start_search
keybind = ctrl+g>t=new_tab
keybind = ctrl+g>r=reload_config
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard:plain

keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+)=decrease_font_size:1

keybind = ctrl+g>f=start_search

keybind = shift+escape=toggle_split_zoom

keybind = ctrl+&=goto_tab:1
keybind = ctrl+é=goto_tab:2
keybind = ctrl+"=goto_tab:3
keybind = ctrl+'=goto_tab:4
keybind = ctrl+(=goto_tab:5
keybind = ctrl+-=goto_tab:6
keybind = ctrl+è=goto_tab:7
keybind = ctrl+_=goto_tab:8
keybind = ctrl+ç=goto_tab:9
keybind = ctrl+à=goto_tab:10

keybind = ctrl+g>tab=toggle_tab_overview

keybind = ctrl+enter=new_split
keybind = ctrl+g>ctrl+k=new_split:up
keybind = ctrl+g>ctrl+j=new_split:down
keybind = ctrl+g>ctrl+h=new_split:left
keybind = ctrl+g>ctrl+l=new_split:right

keybind = ctrl+g>k=goto_split:up
keybind = ctrl+g>j=goto_split:down
keybind = ctrl+g>h=goto_split:left
keybind = ctrl+g>l=goto_split:right

keybind = global:ctrl+shift+enter=toggle_quick_terminal
keybind = ctrl+g>q=close_surface

keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down

keybind = ctrl+backspace=text:\x17

# keybind = ctrl+w>l=goto_split:left
# keybind = ctrl+w>h=goto_split:right
# keybind = ctrl+w>k=goto_split:up
# keybind = ctrl+w>j=goto_split:down

# SHADERS

custom-shader = shaders/cursor_warp.glsl
# custom-shader = shaders/crt.glsl
custom-shader-animation = always
# custom-shader = /home/credo/.config/ghostty/shaders/cursor_warp.glsl
